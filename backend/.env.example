# ==========================================
# CẤU HÌNH MẪU BACKEND (FASTAPI & MONGODB)
# Copy file này thành .env và chỉnh sửa thông số phù hợp
# ==========================================

PORT=8000
HOST=0.0.0.0

# Kết nối MongoDB (Local hoặc Atlas Cloud)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=QuanLyThietBiMayTinh

# JWT Secret & Bảo mật
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_SECURE=false
# Mật khẩu tùy chọn để kích hoạt tài khoản admin mẫu khi chạy seed.py
SEED_ADMIN_PASSWORD=

# Cấu hình CORS Frontend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
